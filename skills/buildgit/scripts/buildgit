#!/usr/bin/env bash

set -euo pipefail
BUILDGIT_VERSION="1.4.3-dev"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "${SCRIPT_DIR}/lib/jenkins-common.sh"

JOB_NAME=""
VERBOSE_MODE=false
CONSOLE_MODE=""
THREADS_MODE=false
COMMAND=""
COMMAND_ARGS=()

_DEFAULT_LINE_FORMAT="%s #%n id=%c Tests=%t Took %d on %I (%r)"
_DEFAULT_THREADS_FORMAT="  [%-14a] %S %g %p %e / %E"

_LINE_FORMAT_STRING="${_DEFAULT_LINE_FORMAT}"
_THREADS_FORMAT="${BUILDGIT_THREADS_FORMAT:-${_DEFAULT_THREADS_FORMAT}}"

POLL_INTERVAL="${POLL_INTERVAL:-5}"
MAX_BUILD_TIME="${MAX_BUILD_TIME:-1800}"
MONITOR_SETTLE_MAX_SECONDS="${MONITOR_SETTLE_MAX_SECONDS:-45}"
MONITOR_SETTLE_STABLE_POLLS="${MONITOR_SETTLE_STABLE_POLLS:-3}"
_PROGRESS_BAR_LINE_COUNT=0
_FOLLOW_BUILD_ESTIMATE_MS=""
_FOLLOW_STAGE_ESTIMATES_JSON="{}"

_follow_mode_cleanup() {
    local exit_code=$?
    echo ""
    bg_log_warning "Monitoring stopped by user"
    if [[ -n "${_FOLLOW_JOB_NAME:-}" ]]; then
        bg_log_essential "Resume monitoring with: buildgit status -f -j ${_FOLLOW_JOB_NAME}"
    fi
    exit 130
}

_FOLLOW_JOB_NAME=""

source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/status_parsing_and_format.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/follow_progress_core.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/status_execution.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/monitor_helpers.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/job_helpers.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/build_command_options.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/cmd_agents.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/cmd_queue.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/cmd_timing.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/cmd_pipeline.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/buildgit_cli.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/buildgit_status_follow.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/buildgit_job_resolve.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/buildgit_status_cmd.sh"
source "${BUILDGIT_SKILL_LIB_DIR}/buildgit/buildgit_push_build.sh"

# Compatibility anchors for source-based tests:
# - _monitor_build contains bg_log_progress "Build in progress... (${elapsed}s elapsed)"
# - _monitor_build uses _track_nested_stage_changes
_monitor_build() {
    __buildgit_monitor_build_impl "$@"
}

_display_build_in_progress_banner() {
    __buildgit_display_build_in_progress_banner_impl "$@"
}

cmd_passthrough() {
    # Execute git with the command and all arguments
    # Returns git's exit code
    # Spec reference: buildgit-spec.md, Unknown Commands
    git "$@"
}

main() {
    parse_global_options "$@"

    # If no command provided, show usage and exit
    if [[ -z "$COMMAND" ]]; then
        show_usage
        exit 1
    fi

    # Command routing (placeholder - to be implemented in Chunk 3)
    case "$COMMAND" in
        status)   cmd_status "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        agents)   cmd_agents "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        timing)   cmd_timing "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        pipeline) cmd_pipeline "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        queue)    cmd_queue "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        push)     cmd_push "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        build)    cmd_build "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
        *)        cmd_passthrough "$COMMAND" "${COMMAND_ARGS[@]+"${COMMAND_ARGS[@]}"}" ;;
    esac
}

if [[ -z "${_BUILDGIT_TESTING:-}" ]]; then
    main "$@"
fi
